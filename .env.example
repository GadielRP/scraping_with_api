# =========================================================
# Docker / Compose
# =========================================================

APP_ENV_FILE=.env
REQUIREMENTS_FILE=requirements_cloud.txt


# =========================================================
# PostgreSQL / Database
# =========================================================

POSTGRES_DB=sofascore_odds
POSTGRES_USER=sofascore
POSTGRES_PASSWORD=change_me

# IMPORTANT:
# Inside Docker Compose, the database host is "postgres", not "localhost" or "127.0.0.1".
DATABASE_URL=postgresql+psycopg://sofascore:change_me@postgres:5432/sofascore_odds

DB_CONNECT_TIMEOUT=5


# =========================================================
# Redis
# Optional. Not used by default.
# =========================================================

REDIS_URL=


# =========================================================
# Scheduler Configuration
# =========================================================

POLL_INTERVAL_MINUTES=5
DISCOVERY_INTERVAL_HOURS=3
DISCOVERY2_INTERVAL_HOURS=6
PRE_START_WINDOW_MINUTES=120
PRE_START_WORKERS=5
PRE_START_ODDS_MOMENTS=120,30,5,0,-5
PRE_START_ODDS_MOMENT_TOLERANCE_MINUTES=3
ODDSPORTAL_OPENING_CAPTURE_MINUTES=120

INTRADAY_RESULT_FRESHNESS_WINDOW_MINUTES=390


# =========================================================
# Timezone
# =========================================================

TIMEZONE=America/Mexico_City
TZ=America/Mexico_City


# =========================================================
# Debug / Pipeline Toggles
# =========================================================

global_debug_mode=true
ENABLE_PILLAR_PIPELINE=true
ENABLE_LEGACY_ALERT_PIPELINE=false
ENABLE_STANDINGS_COMPETITION_METADATA_ENRICHMENT=true
FORCE_STANDINGS_COMPETITION_METADATA_REFRESH=false
# Optional overrides. If omitted, Config defaults to workers=2 and H2H max=200.
# ALERT_PIPELINE_WORKERS=2
# PILLAR_PIPELINE_WORKERS=2
# MATCHUP_TEAM_HISTORY_WORKERS=2
# MATCHUP_H2H_MAX_EVENTS=200
APP_MEMORY_LIMIT=768m


# =========================================================
# Matchup / Standings Settings
# =========================================================

MATCHUP_STANDINGS_GROUP_BY_CONFERENCE=false


# =========================================================
# Logging
# =========================================================

LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s


# =========================================================
# Rate Limiting / Retries
# =========================================================

REQUEST_DELAY_SECONDS=0.5
MAX_RETRIES=3

# OddsPapi API. One key keeps serial behavior; two comma-separated keys enable
# up to two concurrent pre-start event workers.
ODDSPAPI_KEY=replace_with_key_1,replace_with_key_2,replace_with_key_3
ODDSPAPI_BASE_URL=https://api.oddspapi.io
ODDSPAPI_TIMEOUT_SECONDS=15
ODDSPAPI_DEFAULT_BOOKMAKERS=pinnacle
ODDSPAPI_DEFAULT_LANGUAGE=en
ODDSPAPI_DEFAULT_ODDS_FORMAT=decimal
ODDSPAPI_DEFAULT_VERBOSITY=3
# Local scheduler time (TIMEZONE) for UTC-day fixture discovery.
# 17:47 avoids sharing the :45 pre-start tick.
ODDSPAPI_FIXTURE_DISCOVERY_TIMES=17:47
ODDSPAPI_FIXTURE_DISCOVERY_CATCHUP_LOOKBACK_HOURS=36
ODDSPAPI_FIXTURE_DISCOVERY_MAX_CATCHUP_RUNS=2
ODDSPAPI_FIXTURES_COOLDOWN_SECONDS=2.0
# Comma-separated endpoint=seconds values.
ODDSPAPI_ENDPOINT_COOLDOWNS=odds=0.5,historical-odds=5.0,fixtures=2.0

# Oddspapi pre-start odds ingestion. This runs inside the normal pre-start job;
# it does not register a second schedule and only requests already-mapped events.
ENABLE_ODDSPAPI_PRE_START_ODDS=true
# Supported values: odds, historical-odds
ODDSPAPI_PRE_START_ODDS_ENDPOINT=historical-odds
ODDSPAPI_PRE_START_WORKERS=3
ODDSPAPI_PRE_START_BOOKMAKERS=pinnacle,bet365
# Exchange bookmakers are included in /odds, but their historical endpoint
# is queried one outcome at a time only at the configured key moments.
ODDSPAPI_PRE_START_EXCHANGE_BOOKMAKERS=
ODDSPAPI_PRE_START_EXCHANGE_MARKET_KEYS=1x2_full_time,home_away_full_time,over_under_full_time,asian_handicap_full_time
ODDSPAPI_PRE_START_EXCHANGE_MAIN_LINE_ONLY=true
ODDSPAPI_PRE_START_EXCHANGE_INCLUDE_PLAYER_PROPS=false
ODDSPAPI_PRE_START_EXCHANGE_HISTORICAL_MOMENTS=120
ODDSPAPI_PRE_START_EXCHANGE_MAX_OUTCOMES_PER_EVENT=8
ODDSPAPI_PRE_START_EXCHANGE_MAX_REQUESTS_PER_RUN=40
ODDSPAPI_INITIAL_ODDS_MIN_SPAN_MINUTES=60
# Leave blank to ingest all enabled canonical market keys/groups/periods.
ODDSPAPI_PRE_START_MARKET_KEYS=
ODDSPAPI_PRE_START_ALLOWED_MARKET_GROUPS=
ODDSPAPI_PRE_START_ALLOWED_MARKET_PERIODS=
# 0 means no per-run cap.
ODDSPAPI_PRE_START_MAX_EVENTS_PER_RUN=0


# =========================================================
# Notifications - Telegram
# =========================================================

NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TEST_ONLY_MODE=true
PERSONAL_CHAT_ID=
EXTRA_CHAT_IDS=


# =========================================================
# Proxy Configuration
# =========================================================

PROXY_ENABLED=true
PROXY_PROVIDER=decodo
PROXY_PROTOCOL=http

PROXY_COUNTRY=mx
PROXY_CITY=
PROXY_SESSION_DURATION_MINUTES=5

PROXY_MODE_ODDSPORTAL=sticky
PROXY_MODE_SOFASCORE=rotating

PROXY_USERNAME=
PROXY_USERNAME_BASE=
PROXY_PASSWORD=
PROXY_ENDPOINT=

PROXY_ROTATION_INTERVAL=5
PROXY_MAX_RETRIES=3

PROXY_ROTATE_ON_ODDSPORTAL_BROWSER_RESTART=true
PROXY_ROTATE_ON_SOFASCORE_PROXY_ERROR=true
PROXY_LOG_SAFE=true


# =========================================================
# OddsPortal General
# =========================================================

# When disabled, OddsPAPI historical odds remain the opening-odds fallback.
# The earliest active quote is accepted only after the configured 60-minute span.
ODDSPORTAL_SCRAPING_ENABLED=false
ODDSPORTAL_PARALLEL_BROWSERS=1
ODDSPORTAL_PREVIOUS_CYCLE_TIMEOUT=120
ODDSPORTAL_ALERT_WAIT_TIMEOUT=180

# Provider scraping policy, bookmakers, hover, language, browser behavior and
# Playwright timeouts are versioned in modules/oddsportal/scraping_settings.py.
# Market groups and periods are versioned in modules/oddsportal/oddsportal_routes.py.


# =========================================================
# Odds / Extraction Toggles
# =========================================================

ENABLE_TIMESTAMP_CORRECTION=false
ENABLE_ODDS_EXTRACTION=true
PRE_START_TRACKED_COMPETITIONS_ONLY=true
FILTER_PIPELINES_BY_TRACKED_COMPETITIONS=true

STREAK_ALERT_MIN_RESULTS=15


# =========================================================
# Discovery / Filters
# =========================================================

# CSV format is safer for Docker env files.
# The app parser can handle comma-separated values.
EXCLUDED_SPORTS=Table tennis,Darts

# Empty means no explicit source filter.
DISCOVERY_SOURCES_FOR_ALERTS=


# =========================================================
# Dual Process Variables
# These are only for the dual-process / latest 1X2, Home/Away view.
# =========================================================

MARKETS_DUAL_PROCESS=1X2,Home/Away
PERIODS_DUAL_PROCESS=Full Time

# Optional filters for pre-start odds trajectory.
# Leave empty or unset to include all markets and all periods.
PRE_START_ODDS_TRAJECTORY_MARKETS=
PRE_START_ODDS_TRAJECTORY_PERIODS=


# =========================================================
# External APIs
# =========================================================

# Keep this empty in the example.
ODDSpapi_KEY=
